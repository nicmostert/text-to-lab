# Copy this file to .env and fill in the real values.
# Never commit .env to Git. The .gitignore excludes it.

# ArcGIS Online service account
SURVEY123_ARCGIS_USERNAME=YOUR_ARCGIS_SERVICE_ACCOUNT_USERNAME
SURVEY123_ARCGIS_PASSWORD=REPLACE_WITH_ARCGIS_PASSWORD

# Surveys: one per line, exactly "Survey name|ArcGIS item ID"
# Replace these examples and add/remove lines as needed.
SURVEY123_SURVEYS=
    Example survey 1|REPLACE_WITH_SURVEY_ITEM_ID
    Example survey 2|REPLACE_WITH_ANOTHER_ITEM_ID

# Alert email and local timezone
SAMPLE_ALERT_RECIPIENT=lab-recipient-one@example.org;lab-recipient-two@example.org
SAMPLE_ALERT_TIMEZONE=Pacific/Auckland

# SMTP settings supplied by your IT/email administrator.
# Typical submission ports: 587 with STARTTLS, or 465 with SSL.
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USERNAME=YOUR_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=survey-notifier@example.org
SMTP_STARTTLS=true
SMTP_SSL=false
